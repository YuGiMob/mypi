{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@earendil-works/pi-coding-agent": ["./npm/node_modules/@earendil-works/pi-coding-agent"],
      "@earendil-works/pi-tui": ["./npm/node_modules/@earendil-works/pi-tui"],
      "typebox": ["./npm/node_modules/typebox"],
      "vitest": ["./npm/node_modules/vitest"]
    }
  },
  "include": [
    "extensions/**/*.ts"
  ]
}
