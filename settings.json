{
  "lastChangelogVersion": "1.0.3",
  "packages": [
    "npm:pi-git-commit",
    "npm:pi-msg-queue",
    "npm:pi-tps-status",
    "npm:pi-tor-proxy",
    "npm:pi-msg-workflow",
    "npm:pi-context-view",
    "npm:pi-unsloth-webtools",
    "../../pi-hashline-edit-pro"
  ],
  "defaultThinkingLevel": "xhigh",
  "defaultProjectTrust": "always",
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": false
  },
  "retry": {
    "baseDelayMs": 5000
  },
  "theme": "dark",
  "tokenSpeed": {
    "display": "ttft",
    "tpsSlow": 0,
    "tpsMedium": 15,
    "tpsFast": 30,
    "tpsBlazing": 45,
    "colorSlow": "#ff4444",
    "colorMedium": "#ffaa00",
    "colorFast": "#00ff88",
    "colorBlazing": "#44ddff",
    "slidingWindow": 1000,
    "useProviderTokens": true,
    "countStrategy": "provider",
    "endTpsBehavior": "average"
  },
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4.1-flash",
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "transport": "auto",
  "collapseChangelog": true,
  "quietStartup": false,
  "tuiMode": "fullscreen"
}